{
  "name": "brehlo",
  "private": true,
  "version": "0.1.0",
  "description": "Брехло — вечериночная игра на одном телефоне без ведущего",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "icons": "pwa-assets-generator",
    "lint": "oxlint --deny-warnings"
  },
  "dependencies": {
    "vue": "^3.5.45",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  }
}
